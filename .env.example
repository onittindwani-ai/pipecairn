# Copy to .env and fill in. Never commit .env. Every name is explained in docs/04-ENVIRONMENT-VARIABLES.md

# Core
APP_NAME=pipecairn
DATABASE_URL=sqlite:///./pipecairn.sqlite3
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (32 or more random characters; the app refuses to start on this example value when DEMO_MODE is false or an owner password is set)
SESSION_SECRET=change-me-to-a-long-random-string
# Only after you replace SESSION_SECRET: the old one, so unsubscribe links already emailed keep working. Empty otherwise.
SESSION_SECRET_PREVIOUS=
# draft: nothing leaves the machine. live: real sends, only after docs/09-GO-LIVE-CHECKLIST.md
MODE=draft
# false for any real install. true only for the offline demo with fictional data (it also switches on a public demo password until OWNER_PASSWORD_HASH is set)
DEMO_MODE=false
# Only for a throw away demo on a server database. Leave false.
ALLOW_DEMO_SERVER=false
KILL_SWITCH=false
# The largest request the API accepts, in bytes (25 MB)
MAX_BODY_BYTES=26214400
HANDOFF_DIR=./handoff
# The folder with the demo data. Set automatically when you run from the repository.
SEED_DIR=
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
LOGIN_BURST=5
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=

# Who the messages come from. These three are printed in every email footer and on proposals, so they must be real before MODE=live.
SENDER_NAME=Alex
COMPANY_NAME=Your Company
# Your physical postal address, one line
COMPANY_ADDRESS=
# Optional Reply-To address for outgoing email
REPLY_TO=
# Where this API is reachable from the internet, for the one click unsubscribe link. Optional, https only.
PUBLIC_BASE_URL=

# Which adapter each job uses: seed is offline and safe
EMAIL_ADAPTER=seed
SMS_ADAPTER=seed
CALENDAR_ADAPTER=seed
CRM_ADAPTER=seed
ESIGN_ADAPTER=seed

# Email (smtp_imap): all or none. One account signs in for every mailbox. Plain text (false below) is refused for any host but 127.0.0.1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true

# Texting (telnyx): all or none
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=
TELNYX_BASE_URL=https://api.telnyx.com

# Calendar, Cal.com: all or none
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=
CALCOM_BASE_URL=https://api.cal.com
CALCOM_SLOTS_VERSION=2024-09-04
CALCOM_BOOKINGS_VERSION=2026-02-25

# Calendar, Google (creates events only)
GOOGLE_CALENDAR_TOKEN=

# CRM, Twenty: all or none
TWENTY_BASE_URL=
TWENTY_API_KEY=

# CRM, HubSpot
HUBSPOT_TOKEN=

# CRM, Notion: all or none
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Let CRM, calendar and texting addresses point at a private network address (a self hosted Twenty or Cal.com). Leave false otherwise.
ALLOW_PRIVATE_BASE_URLS=false

# Webhooks and sending rules
WEBHOOK_SHARED_SECRET=
QUIET_START_HOUR=18
QUIET_END_HOUR=8
SEND_WEEKENDS=false

# Business rules (the defaults are the values the product started with)
TARGET_INDUSTRIES=home services,dental,legal,real estate,accounting
MIN_ENROLL_SCORE=40
BOUNCE_PAUSE_RATE=0.05
BOUNCE_MIN_SENDS=20
# For a CSV row with no valid time zone, for example America/New_York. Empty means such rows are flagged and never sent to.
DEFAULT_TIMEZONE=
CURRENCY_SYMBOL='$'
PROPOSAL_VALID_DAYS=14
CONTRACT_NOTICE_DAYS=14
DEAL_VALUE_SMALL_CENTS=150000
DEAL_VALUE_MEDIUM_CENTS=600000
DEAL_VALUE_LARGE_CENTS=1200000
# letter or a4
PAGE_SIZE=letter

# Reply understanding: LLM_BACKEND is offline (default), fixture or anthropic; anthropic needs a key and is UNVERIFIED
LLM_BACKEND=offline
LLM_MODE=fixture
ANTHROPIC_API_KEY=
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
# One model name for both kinds. Empty uses the two above.
LLM_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# Spend limits for the live model. Empty means no limit, so set both before you use anthropic: most calls per process, most dollars in total.
LLM_CALL_BUDGET=
LLM_BUDGET_USD=
LLM_THINKING=default
LLM_FIXTURES_DIR=
LLM_RECORD=false
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Web app
API_BASE_URL=http://127.0.0.1:8000

# Docker compose only: letters and digits only, or percent encoded. Make one: openssl rand -hex 24
POSTGRES_PASSWORD=
