# Copy to .env and fill in. Never commit .env. Explained in docs/04-ENVIRONMENT-VARIABLES.md

# Core
DATABASE_URL=sqlite:///./pipecairn.sqlite3
SESSION_SECRET=change-me-to-a-long-random-string
MODE=draft
DEMO_MODE=true
KILL_SWITCH=false
HANDOFF_DIR=./handoff

# Sign in (make the hash with: python tools/hash_password.py). Keep the single quotes.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
LOGIN_BURST=5
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=

# Which adapter each job uses: seed is offline and safe
EMAIL_ADAPTER=seed
SMS_ADAPTER=seed
CALENDAR_ADAPTER=seed
CRM_ADAPTER=seed
ESIGN_ADAPTER=seed

# Email (smtp_imap)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993

# Texting (telnyx)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_FROM_NUMBER=

# Calendar (calcom or google_calendar)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=
GOOGLE_CALENDAR_TOKEN=

# CRM (twenty, hubspot or notion)
TWENTY_BASE_URL=
TWENTY_API_KEY=
HUBSPOT_TOKEN=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Webhooks and sending rules
WEBHOOK_SHARED_SECRET=
QUIET_START_HOUR=18
QUIET_END_HOUR=8
SEND_WEEKENDS=false

# Reply understanding: LLM_BACKEND is offline (default), fixture or anthropic; anthropic needs a key and is UNVERIFIED
LLM_BACKEND=offline
LLM_MODE=fixture
ANTHROPIC_API_KEY=

# Web app
API_BASE_URL=http://127.0.0.1:8000

# Docker compose only
POSTGRES_PASSWORD=
